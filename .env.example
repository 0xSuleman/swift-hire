# ── Backend env vars (set in Railway dashboard) ───────────────────────────────

# MySQL connection string — Railway provides this automatically when you add a
# MySQL plugin. Copy the JDBC URL from Railway's "Connect" tab.
DATABASE_URL=jdbc:mysql://host:port/dbname?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true

# MySQL credentials — also provided by Railway MySQL plugin
DB_USERNAME=root
DB_PASSWORD=

# JWT secret — use any random 32+ character string
JWT_SECRET=change-me-to-a-random-32-char-string

# Gmail SMTP — your Gmail address + App Password (not your real password)
MAIL_USERNAME=your-gmail@gmail.com
MAIL_PASSWORD=xxxx xxxx xxxx xxxx

# Vercel frontend URL — set after Vercel deployment (no trailing slash)
FRONTEND_URL=https://your-app.vercel.app

# CV upload directory — Railway filesystem is ephemeral, use /tmp
CV_UPLOAD_DIR=/tmp/uploads

# ── Frontend env vars (set in Vercel dashboard) ───────────────────────────────

# Railway backend URL — no trailing slash, no /api suffix
VITE_API_URL=https://your-app.up.railway.app

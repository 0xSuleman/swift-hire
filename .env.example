# ── Backend env vars (set in Render dashboard) ────────────────────────────────

# Aiven MySQL connection details — copy from Aiven service "Connection info" tab
MYSQLHOST=your-aiven-host.aivencloud.com
MYSQLPORT=12345
MYSQLDATABASE=defaultdb
MYSQLUSER=avnadmin
MYSQLPASSWORD=your-aiven-password

# JWT secret — any random 32+ character string
JWT_SECRET=change-me-to-a-random-32-char-string

# Gmail SMTP — your Gmail address + App Password (not your real password)
MAIL_USERNAME=your-gmail@gmail.com
MAIL_PASSWORD=xxxx xxxx xxxx xxxx

# Vercel frontend URL — set after Vercel deployment (no trailing slash)
FRONTEND_URL=https://your-app.vercel.app

# CV upload directory — Render filesystem is ephemeral, use /tmp
CV_UPLOAD_DIR=/tmp/uploads

# ── Frontend env vars (set in Vercel dashboard) ───────────────────────────────

# Render backend URL — no trailing slash, no /api suffix
VITE_API_URL=https://your-app.onrender.com
